# Backend API URL (without trailing slash)
# Since frontend and backend are on the same server, use localhost
NEXT_PUBLIC_API_URL=http://localhost:5000
# Alternative: If you want to use domain (requires API subdomain setup):
# NEXT_PUBLIC_API_URL=https://api.atlanticleatherethiopia.com

# Public API Key (get this from admin panel after backend is deployed)
NEXT_PUBLIC_API_KEY=your_public_api_key_here

# Production environment
NODE_ENV=production



